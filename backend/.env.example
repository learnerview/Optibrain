# Spring Boot Profile Configuration
# Options: dev (LocalStack), prod (Real AWS)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# Database Configuration (Production only - dev uses H2 in-memory)
DB_URL=jdbc:postgresql://localhost:5432/optibrain
DB_USERNAME=optibrain_user
DB_PASSWORD=your_secure_password_here

# AWS Configuration
# For LocalStack (Development)
CLOUD_MODE=LOCALSTACK
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_REGION=us-east-1

# For Real AWS (Production)
# CLOUD_MODE=AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key  # NOT RECOMMENDED - use IAM roles instead
# AWS_SECRET_ACCESS_KEY=your_secret_key  # NOT RECOMMENDED - use IAM roles instead

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Application Configuration
DASHBOARD_REFRESH_INTERVAL=30
ML_PREDICTION_HORIZON=24
ALERTS_ENABLED=true
AUTO_EXECUTE_RECOMMENDATIONS=false

# Cost Analysis Thresholds
IDLE_CPU_THRESHOLD=10
IDLE_DAYS_THRESHOLD=7
UNUSED_EBS_DAYS=30

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000

# Security Configuration
# Generate secure passwords for production!
ADMIN_PASSWORD=change_this_password
USER_PASSWORD=change_this_password
